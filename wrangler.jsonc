{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lab-protocols",
  "compatibility_date": "2026-10-01",
  // 部署前由 wrangler 自动构建，不依赖控制台里的构建命令设置（deploy 和 preview 都适用）
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // 正式版：lab-protocols.<子域>.workers.dev
  "workers_dev": true,
  // 预览版（Worker Previews）：npx wrangler preview 按分支名生成预览，
  // experimental 分支即 experimental-lab-protocols.<子域>.workers.dev
  "preview_urls": true,
  // wrangler preview 要求存在该块；预览版无需单独设置，留空即可
  "previews": {}
}
