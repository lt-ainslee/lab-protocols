---
// 化学结构式：显示 src/assets/structures/ 下的 SVG，深色模式自动反色
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  width?: number;
}

const { src, alt, caption, width = src.width } = Astro.props;
const height = Math.round((src.height * width) / src.width);
---

<figure class="structure">
  <img src={src.src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .structure {
    margin-block: 1.5rem;
    text-align: center;
  }
  .structure img {
    display: block;
    margin-inline: auto;
    max-width: 100%;
    height: auto;
  }
  /* 结构式按黑线透明底绘制，深色模式下反色为白线 */
  :global(:root:not([data-theme='light'])) .structure img {
    filter: invert(1) hue-rotate(180deg);
  }
  .structure figcaption {
    margin-top: 0.5rem;
    font-family: var(--sans);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
